# ==============================================================================
# DeadlineFlow - Environment Configuration (Example)
# ==============================================================================
# Copy this file to '.env' and adjust the values for your environment.
# ==============================================================================

# ==========================================
# 1. Application
# ==========================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://YOUR_IP:8080
VITE_HMR_HOST=YOUR_IP

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_TIMEZONE=Asia/Tehran

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ==========================================
# 2. Logging
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# 3. Database (MySQL)
# ==========================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=deadlineflow
DB_USERNAME=laravel
DB_PASSWORD=root

# ==========================================
# 4. Redis (Cache, Session, Queue)
# ==========================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis

CACHE_STORE=redis
SESSION_DRIVER=redis

# ==========================================
# 5. Queue (RabbitMQ)
# ==========================================
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=rabbitmq
RABBITMQ_QUEUE=deadline_notifications

# ==========================================
# 6. Session
# ==========================================
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to 'true' in production (requires HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# ==========================================
# 7. Broadcasting & Filesystem
# ==========================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ==========================================
# 8. Mail (Log for MVP)
# ==========================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# 9. AWS (Optional)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# 10. Frontend (Vite)
# ==========================================
VITE_APP_NAME="${APP_NAME}"

# ==========================================
# 11. Horizon (Queue Monitoring)
# ==========================================
HORIZON_USER=admin
HORIZON_PASSWORD=horizon

# ==========================================
# 12. Swagger (API Documentation)
# ==========================================
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://YOUR_IP:8080